# Optional. The app already points at the SadBarz Supabase project (src/lib/supabase.ts).
# Set these to use a different project, e.g. a test one.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Or turn accounts off and keep them on the device only:
# EXPO_PUBLIC_ACCOUNTS=preview
